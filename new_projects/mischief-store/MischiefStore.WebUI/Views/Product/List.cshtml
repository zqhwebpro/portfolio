@model MischiefStore.WebUI.Models.ProductsListViewModel

@{
    ViewBag.Title = string.IsNullOrEmpty(Model.CurrentCategory) ? "All Pranks & Magic" : Model.CurrentCategory;
}

<!-- Category Banner Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="font-weight-bold text-dark mb-1">
            <i class="fa-solid fa-sparkles text-warning mr-2"></i>
            @(string.IsNullOrEmpty(Model.CurrentCategory) ? "Featured Mischief & Magic Catalogue" : Model.CurrentCategory)
        </h2>
        <small class="text-muted">
            Showing @Model.Products.Count() of @Model.PagingInfo.TotalItems certified gags &amp; illusions.
        </small>
    </div>
</div>

<!-- Product Cards Grid -->
<div class="row">
    @if (!Model.Products.Any())
    {
        <div class="col-12 text-center py-5">
            <i class="fa-solid fa-ghost fa-3x text-muted mb-3"></i>
            <h4 class="text-muted font-weight-bold">Poof! No items found in this category.</h4>
            <a href="@Url.Action("List", new { category = (string)null })" class="btn btn-mischief-primary mt-3">
                View All Pranks
            </a>
        </div>
    }
    else
    {
        foreach (var p in Model.Products)
        {
            @Html.Partial("_ProductSummary", p)
        }
    }
</div>

<!-- Bootstrap Responsive Pagination -->
<div class="text-center">
    @Html.PageLinks(Model.PagingInfo, x => Url.Action("List", new { page = x, category = Model.CurrentCategory }))
</div>
