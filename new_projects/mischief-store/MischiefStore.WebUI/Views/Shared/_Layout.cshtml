<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Mischief &amp; Magic Co. // Novelty Gag &amp; Magic Shop</title>
    
    <!-- Bootstrap & FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">
    
    <!-- Custom Theme Stylesheet -->
    <link rel="stylesheet" href="~/Content/Site.css" />
</head>
<body>
    <!-- Top Playful Announcement Bar -->
    <div class="py-1 text-center font-weight-bold text-white" style="background: #2E0854; font-size: 0.75rem; letter-spacing: 0.05em;">
        ★ 100% UNTRACEABLE PRANKS &bull; FREE SHIPPING ON ORDERS OVER $35 &bull; DISCREET AUDIT-STYLE PACKAGING ★
    </div>

    <!-- Navigation Header -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-mischief py-3">
        <div class="container">
            <a class="navbar-brand brand-sparkle d-flex align-items-center" href="@Url.Action("List", "Product")">
                <i class="fa-solid fa-wand-magic-sparkles mr-2 text-warning"></i>
                <span>MISCHIEF &amp; MAGIC <span class="brand-badge ml-1">CO.</span></span>
            </a>
            
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mr-auto ml-lg-4">
                    <li class="nav-item">
                        <a class="nav-link text-white font-weight-bold" href="@Url.Action("List", "Product", new { category = (string)null })">
                            <i class="fa-solid fa-boxes-stacked mr-1 text-warning"></i> Full Catalogue
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" href="@Url.Action("Index", "Admin")">
                            <i class="fa-solid fa-lock mr-1"></i> Admin Portal
                        </a>
                    </li>
                </ul>

                <!-- Shopping Cart Summary Widget -->
                <div class="navbar-nav">
                    @Html.Action("Summary", "Cart")
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="container my-4 flex-grow-1">
        <!-- TempData Notification Alerts -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show font-weight-bold shadow-sm" role="alert">
                <i class="fa-solid fa-circle-check mr-2"></i> @TempData["Message"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row">
            <!-- Left Sidebar: Category Filter -->
            <div class="col-lg-3 col-md-4 mb-4">
                <div class="card shadow-sm border-0 mb-3" style="border-radius: 12px;">
                    <div class="card-header bg-dark text-white font-weight-bold py-3" style="border-radius: 12px 12px 0 0;">
                        <i class="fa-solid fa-masks-theater text-warning mr-2"></i> Prank Categories
                    </div>
                    <div class="card-body p-2">
                        @Html.Action("Menu", "Nav")
                    </div>
                </div>

                <!-- Customer Trust Badge Card -->
                <div class="card bg-white shadow-sm border-0 p-3" style="border-radius: 12px; font-size: 0.85rem;">
                    <div class="font-weight-bold text-uppercase text-muted mb-2">
                        <i class="fa-solid fa-shield-halved text-success mr-1"></i> The Mischief Guarantee
                    </div>
                    <p class="text-secondary mb-0">
                        All shock pens tested for maximum startle coefficient. Disappearing inks guaranteed 100% stain-free on cotton &amp; silk.
                    </p>
                </div>
            </div>

            <!-- Right Content Area -->
            <div class="col-lg-9 col-md-8">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mischief-footer py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-left mb-3 mb-md-0">
                    <h5 class="text-white font-weight-bold mb-1">
                        <i class="fa-solid fa-hat-wizard text-warning mr-2"></i> MISCHIEF &amp; MAGIC CO.
                    </h5>
                    <small class="text-muted">
                        Enterprise ASP.NET MVC 5 &bull; C# &bull; Entity Framework 6 Code-First &bull; Ninject DI
                    </small>
                </div>
                <div class="col-md-6 text-center text-md-right">
                    <span class="badge badge-warning text-dark p-2 font-weight-bold">
                        <i class="fa-solid fa-circle-dot text-danger mr-1"></i> DISPATCH INVENTORY: LIVE
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
