@model MischiefStore.WebUI.Models.CartIndexViewModel

@{
    ViewBag.Title = "Mischief & Magic Co. - Your Shopping Cart";
}

<div class="row">
    <div class="col-xs-12">
        <div class="page-header" style="border-bottom: 2px solid var(--carnival-gold); margin-top: 10px;">
            <h2><i class="glyphicon glyphicon-shopping-cart" style="color: var(--carnival-red);"></i> Your Cart of Chaos</h2>
            <p class="text-muted">Review your arsenal of gags, tricks, and magical anomalies before proceeding to checkout.</p>
        </div>

        @if (!Model.Cart.Lines.Any())
        {
            <div class="alert alert-warning text-center" style="padding: 40px 20px; border-radius: 12px;">
                <span style="font-size: 48px; display: block; margin-bottom: 15px;">🎩💨</span>
                <h3>Your cart vanished into thin air!</h3>
                <p>You currently have no pranks or magic supplies queued up for delivery.</p>
                <div style="margin-top: 25px;">
                    <a href="@Model.ReturnUrl" class="btn btn-carnival-gold btn-lg">
                        <i class="glyphicon glyphicon-arrow-left"></i> Browse Mischief Catalog
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="panel panel-default" style="box-shadow: 0 4px 15px rgba(0,0,0,0.06); border-radius: 12px; overflow: hidden;">
                <div class="panel-heading" style="background: var(--bg-dark); color: #fff; padding: 15px 20px;">
                    <h3 class="panel-title" style="font-weight: 700; letter-spacing: 0.5px;">
                        <i class="glyphicon glyphicon-list-alt"></i> Line Items (@Model.Cart.Lines.Sum(x => x.Quantity) items)
                    </h3>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped" style="margin-bottom: 0;">
                        <thead>
                            <tr style="background: #f8f9fa;">
                                <th style="width: 100px;">Item</th>
                                <th>Product Details</th>
                                <th class="text-center" style="width: 120px;">Quantity</th>
                                <th class="text-right" style="width: 140px;">Unit Price</th>
                                <th class="text-right" style="width: 140px;">Subtotal</th>
                                <th class="text-center" style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Cart.Lines)
                            {
                                <tr>
                                    <td class="text-center" style="vertical-align: middle;">
                                        @if (line.Product.ImageData != null)
                                        {
                                            <img src="@Url.Action("GetImage", "Product", new { line.Product.ProductID })" 
                                                 alt="@line.Product.Name" 
                                                 class="img-thumbnail" 
                                                 style="max-height: 60px; max-width: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div style="width: 55px; height: 55px; background: #eee; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 20px;">
                                                📦
                                            </div>
                                        }
                                    </td>
                                    <td style="vertical-align: middle;">
                                        <h4 style="margin: 0 0 5px 0; font-weight: 700; color: var(--bg-dark);">@line.Product.Name</h4>
                                        <span class="badge badge-info" style="background: var(--carnival-purple);">@line.Product.Category</span>
                                    </td>
                                    <td class="text-center" style="vertical-align: middle;">
                                        <span class="badge" style="font-size: 14px; background: var(--bg-dark); padding: 6px 12px;">@line.Quantity</span>
                                    </td>
                                    <td class="text-right" style="vertical-align: middle; font-size: 15px; font-weight: 600;">
                                        @line.Product.Price.ToString("c")
                                    </td>
                                    <td class="text-right" style="vertical-align: middle; font-size: 16px; font-weight: 700; color: var(--carnival-red);">
                                        @((line.Quantity * line.Product.Price).ToString("c"))
                                    </td>
                                    <td class="text-center" style="vertical-align: middle;">
                                        @using (Html.BeginForm("RemoveFromCart", "Cart"))
                                        {
                                            @Html.Hidden("ProductId", line.Product.ProductID)
                                            @Html.HiddenFor(x => x.ReturnUrl)
                                            <button type="submit" class="btn btn-sm btn-danger" title="Remove from Cart" style="border-radius: 6px;">
                                                <i class="glyphicon glyphicon-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background: #fdfaf3; font-size: 18px;">
                                <td colspan="4" class="text-right" style="font-weight: 700;">Grand Total:</td>
                                <td class="text-right" style="font-weight: 900; color: var(--carnival-red); font-size: 20px;">
                                    @Model.Cart.ComputeTotalValue().ToString("c")
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="row" style="margin-top: 25px; margin-bottom: 40px;">
                <div class="col-sm-6">
                    <a href="@Model.ReturnUrl" class="btn btn-default btn-lg" style="border-radius: 8px; font-weight: 600;">
                        <i class="glyphicon glyphicon-arrow-left"></i> Continue Prank Shopping
                    </a>
                </div>
                <div class="col-sm-6 text-right">
                    @Html.ActionLink("Proceed to Checkout 🎩➔", "Checkout", "Cart", null, new { @class = "btn btn-carnival-gold btn-lg", style = "box-shadow: 0 4px 12px rgba(230, 81, 0, 0.3);" })
                </div>
            </div>
        }
    </div>
</div>
