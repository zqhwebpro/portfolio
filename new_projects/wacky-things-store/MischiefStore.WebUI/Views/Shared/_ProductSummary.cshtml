@model MischiefStore.Domain.Entities.Product

<div class="col-lg-6 col-md-12 mb-4">
    <div class="product-card">
        <!-- Visual Icon / Image Header -->
        <div class="card-img-placeholder">
            @if (Model.ImageData != null)
            {
                <img src="@Url.Action("GetImage", "Product", new { Model.ProductID })" class="img-fluid" style="max-height: 140px; object-fit: cover;" alt="@Model.Name" />
            }
            else
            {
                <i class="fa-solid @(string.IsNullOrEmpty(Model.IconClass) ? "fa-wand-magic-sparkles" : Model.IconClass)"></i>
            }
        </div>

        <div class="card-body d-flex flex-column p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="category-tag">@Model.Category</span>
                <span class="product-price-badge">@Model.Price.ToString("c")</span>
            </div>

            <h5 class="card-title font-weight-bold text-dark mb-2" style="font-size: 1.1rem;">
                @Model.Name
            </h5>

            <p class="card-text text-muted flex-grow-1" style="font-size: 0.88rem; line-height: 1.4;">
                @Model.Description
            </p>

            <!-- Add to Cart Form -->
            @using (Html.BeginForm("AddToCart", "Cart"))
            {
                <div class="mt-3">
                    @Html.HiddenFor(x => x.ProductID)
                    @Html.Hidden("returnUrl", Request.Url.PathAndQuery)
                    <button type="submit" class="btn btn-mischief-primary btn-block py-2">
                        <i class="fa-solid fa-cart-plus mr-1"></i> Add Prank to Cart
                    </button>
                </div>
            }
        </div>
    </div>
</div>
