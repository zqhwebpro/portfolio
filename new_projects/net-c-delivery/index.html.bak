    <!-- ═══════════════════════════════════════════════════════════════════
         8. API CONFIGURATION & CREDENTIALS MODAL
         ═══════════════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="apiConfigModal" tabindex="-1" aria-labelledby="modalServiceTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content tech-modal">
                <div class="modal-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-2 d-flex align-items-center justify-content-center text-white p-2" id="modalLogoBox" style="width: 38px; height: 38px;">
                            <i id="modalLogoIcon" class="fa-solid fa-plug"></i>
                        </div>
                        <div>
                            <h5 class="modal-title font-mono fw-bold fs-6 mb-0" id="modalServiceTitle">API Gateway Setup</h5>
                            <span class="font-mono text-secondary text-xs" id="modalServiceSubtitle">REST Webhooks &bull; TLS 1.3</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <input type="hidden" id="modalCurrentServiceId" value="">

                    <!-- Demographics banner -->
                    <div class="p-3 rounded mb-3 bg-black bg-opacity-40 border border-secondary border-opacity-30">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="font-mono text-xs text-warning fw-bold" id="modalDemoRank">Demographic Target</span>
                            <a href="#" target="_blank" rel="noopener" id="modalOutwardLink" class="font-mono text-xs text-info text-decoration-none">
                                Developer Portal <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                            </a>
                        </div>
                        <p class="font-sans text-xs text-secondary mb-0" id="modalDemoDesc">Demographic details</p>
                    </div>

                    <form id="apiVerificationForm" onsubmit="handleApiVerification(event)">
                        <div class="mb-3">
                            <label class="form-label font-mono text-xs text-secondary fw-semibold">Client ID / Application API Key</label>
                            <input type="text" id="apiClientIdInput" class="tech-form-control" placeholder="e.g. 6ImzVINJ53LfMWCPoh_gBblTL55hqUNfIBN-7TG2" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-mono text-xs text-secondary fw-semibold">Client Secret / Private Signing Token</label>
                            <input type="password" id="apiSecretInput" class="tech-form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-mono text-xs text-secondary fw-semibold">Store Location GUID / Merchant ID</label>
                            <input type="text" id="apiLocationIdInput" class="tech-form-control" placeholder="e.g. loc_parma_grill_01" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-mono text-xs text-secondary fw-semibold">Inbound Webhook Endpoint URL</label>
                            <input type="text" id="apiWebhookUrlDisplay" class="tech-form-control text-secondary bg-black" readonly>
                        </div>

                        <!-- Live Diagnostic Handshake Console -->
                        <div id="verificationConsole" class="p-3 rounded bg-black border border-secondary border-opacity-40 font-mono text-xs d-none mb-3">
                            <div class="d-flex align-items-center justify-content-between text-secondary border-bottom border-secondary border-opacity-30 pb-1 mb-2">
                                <span><i class="fa-solid fa-terminal me-1"></i> HANDSHAKE DIAGNOSTIC STREAM</span>
                                <span id="consoleTimer" class="text-info">0 ms</span>
                            </div>
                            <div id="step1" class="text-info mb-1"><i class="fa-solid fa-spinner fa-spin me-1"></i> [TLS 1.3] Handshake initialization...</div>
                            <div id="step2" class="text-secondary mb-1 d-none">[OAuth 2.0] Authenticating bearer token...</div>
                            <div id="step3" class="text-secondary mb-1 d-none">[Location GUID] Validating store geofence...</div>
                            <div id="step4" class="text-success fw-bold d-none"><i class="fa-solid fa-circle-check me-1"></i> [200 OK] Handshake verified and online!</div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-2">
                            <button type="button" class="btn-excel-subtle" onclick="fillDemoCredentials()">
                                <i class="fa-solid fa-wand-magic-sparkles text-warning me-1"></i> Fill Demo Credentials
                            </button>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn-excel-subtle" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" id="btnSubmitVerify" class="btn-excel">
                                    <i class="fa-solid fa-shield-check me-1"></i> Submit &amp; Verify API
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous">
    </script>

    <!-- ====================================================================
         EXCEL x SEO SPIDER x GOOGLE ANALYTICS CONTROLLER ENGINE
         ==================================================================== -->
    <script>
        // Delivery Platforms Registry & Metadata
        const DELIVERY_SERVICES = {
            toast: {
                id: 'toast',
