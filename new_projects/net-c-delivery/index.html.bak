<!DOCTYPE html>
<html lang="en-US">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>DineDispatch // API Spider & POS Analytics Console | Google Analytics x SEO Spider x Excel</title>
    <meta name="description"
        content="Enterprise delivery gateway console. Hybrid Google Analytics telemetry, SEO Spider technical crawl matrix, and Microsoft Excel spreadsheet architecture for POS and delivery fleet integration." />
    <meta name="keywords"
        content="Delivery API Spider, Google Analytics Dashboard, SEO Spider Audit Matrix, Excel Spreadsheet UI, Toast POS, DoorDash Drive, Uber Direct, Grubhub Direct, Square, Clover, .NET 9" />
    <meta name="author" content="Zach Heindel - Restaurant Delivery Gateway Engineering" />
    <link rel="canonical" href="https://zqhwebpro.github.io/portfolio/new_projects/net-c-delivery/index.html" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="DineDispatch // API Spider & POS Analytics Console" />
    <meta property="og:description"
        content="Google Analytics meets SEO Spider meets Microsoft Excel for restaurant delivery fleet and POS gateway management." />
    <meta property="og:image" content="./images/hero-cheesesteak.jpg" />

    <!-- Sitewide Favicon -->
    <link rel="icon" href="./favicon.png" type="image/png" />
    <link rel="shortcut icon" href="./favicon.png" type="image/png" />
    <link rel="alternate icon" href="../../favicon.png" type="image/png" />

    <!-- FontAwesome 6.5.1 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap 5.3.3 CSS for Modal Dialog Support -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <style>
        :root {
            /* Excel Iconic Colors */
            --excel-green-header: #107c41;
            --excel-green-dark: #0b552c;
            --excel-green-accent: #0f6f39;
            --excel-selection: #107c41;
            --excel-grid-line: #2d3748;
            --excel-grid-bg: #0f172a;
            --excel-cell-active: #1e293b;
            
            /* Google Analytics Colors */
            --ga-blue: #1a73e8;
            --ga-blue-hover: #1765cc;
            --ga-surface: #131d31;
            --ga-border: #1e293b;
            --ga-pill-blue: #e8f0fe;
            --ga-metric-green: #00e676;
            --ga-pulse: #34a853;

            /* SEO Spider Status Badges */
            --spider-200: #059669;
            --spider-200-bg: rgba(5, 150, 105, 0.18);
            --spider-401: #d97706;
            --spider-401-bg: rgba(217, 119, 6, 0.18);
            --spider-500: #dc2626;
            --spider-500-bg: rgba(220, 38, 38, 0.18);

            /* Dark Technical Theme Variables */
            --bg-app: #080c14;
            --bg-panel: #0d131f;
            --bg-panel-alt: #111827;
            --text-main: #f1f5f9;
            --text-sub: #94a3b8;
            --text-dim: #64748b;
            --border-tech: #1f293d;
            --border-tech-bright: #334155;
            --font-mono: 'JetBrains Mono', monospace;
            --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-app);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        .font-mono {
            font-family: var(--font-mono) !important;
        }

        /* Persistent Navigation Anchors */
        #back-btn-np,
        #case-study-btn-np {
            transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease;
        }
        #back-btn-np:hover,
        #case-study-btn-np:hover {
            transform: scale(1.08);
            background: rgba(30, 41, 59, 0.95) !important;
            border-color: #38bdf8 !important;
        }

        /* 1. TOP EXCEL & GOOGLE ANALYTICS APP TITLEBAR */
        .app-top-ribbon {
            background: linear-gradient(90deg, #107c41 0%, #0c5a2f 35%, #0f172a 100%);
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            padding: 8px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            z-index: 30;
        }

        .app-brand-lockup {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .excel-icon-tile {
            width: 30px;
            height: 30px;
            background: #ffffff;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #107c41;
            font-weight: 900;
            font-size: 17px;
            font-family: var(--font-sans);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
        }

        .app-title-text {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.3px;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .app-title-tag {
            font-size: 11px;
            font-family: var(--font-mono);
            font-weight: 600;
            background: rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 2px 7px;
            border-radius: 4px;
            color: #a7f3d0;
        }

        /* GA4 Realtime Stream Pill */
        .ga-realtime-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid var(--border-tech-bright);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11.5px;
            font-family: var(--font-mono);
            color: #38bdf8;
        }

        .pulse-beacon {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: pulse-ring 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
        }

        @keyframes pulse-ring {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        /* 2. EXCEL FORMULA BAR */
        .excel-formula-bar {
            background: #0f172a;
            border-bottom: 1px solid var(--border-tech);
            padding: 4px 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: var(--font-mono);
            font-size: 12px;
            z-index: 25;
        }

        .excel-name-box {
            background: #1e293b;
            border: 1px solid #334155;
            color: #f8fafc;
            padding: 3px 10px;
            min-width: 60px;
            text-align: center;
            font-weight: 700;
            border-radius: 2px;
        }

        .excel-fx-icon {
            color: #94a3b8;
            font-weight: 700;
            font-style: italic;
            font-size: 13px;
            padding: 0 4px;
        }

        .excel-formula-input {
            flex: 1;
            background: #1e293b;
            border: 1px solid #334155;
            color: #38bdf8;
            padding: 3px 10px;
            border-radius: 2px;
            outline: none;
            font-family: var(--font-mono);
            font-size: 12px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* 3. GOOGLE ANALYTICS METRIC SCORECARDS */
        .ga-metric-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 12px;
            padding: 14px 16px 8px 16px;
            background: #0b111c;
            border-bottom: 1px solid var(--border-tech);
        }

        .ga-metric-card {
            background: #101726;
            border: 1px solid var(--border-tech);
            border-radius: 6px;
            padding: 10px 14px;
            position: relative;
            transition: border-color 0.15s ease, background 0.15s ease;
        }

        .ga-metric-card:hover {
            border-color: #38bdf8;
            background: #131d31;
        }

        .ga-metric-label {
            font-size: 11px;
            font-family: var(--font-mono);
            color: var(--text-sub);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 4px;
        }

        .ga-metric-value {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            font-family: var(--font-sans);
            display: flex;
            align-items: baseline;
            gap: 6px;
        }

        .ga-metric-delta {
            font-size: 11px;
            font-family: var(--font-mono);
            font-weight: 700;
            padding: 1px 5px;
            border-radius: 3px;
        }

        .delta-positive {
            color: #34d399;
            background: rgba(52, 211, 153, 0.15);
        }

        .delta-neutral {
            color: #38bdf8;
            background: rgba(56, 189, 248, 0.15);
        }

        /* 4. SEO SPIDER AUDIT RIBBON & TABS */
        .spider-toolbar {
            background: #0e1524;
            border-bottom: 1px solid var(--border-tech);
            padding: 8px 16px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .spider-filter-group {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .spider-filter-pill {
            background: #182234;
            border: 1px solid var(--border-tech-bright);
            color: var(--text-sub);
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11.5px;
            font-family: var(--font-mono);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .spider-filter-pill:hover {
            background: #233048;
            color: #ffffff;
            border-color: #38bdf8;
        }

        .spider-filter-pill.active {
            background: #107c41;
            border-color: #16a34a;
            color: #ffffff;
        }

        .spider-search-box {
            background: #131d31;
            border: 1px solid var(--border-tech-bright);
            border-radius: 4px;
            padding: 4px 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-sub);
            font-size: 12px;
            min-width: 240px;
        }

        .spider-search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: #ffffff;
            font-size: 12px;
            font-family: var(--font-mono);
            width: 100%;
        }

        /* 5. PROGRESSIVE NOTICE BANNER (STEPPER) */
        .stepper-notice-strip {
            background: #0d1726;
            border-bottom: 1px solid var(--border-tech);
            padding: 8px 16px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            font-size: 12px;
        }

        .stepper-step-badges {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .step-pill {
            padding: 3px 9px;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border: 1px solid transparent;
        }

        .step-pill.active {
            background: #1e3a8a;
            color: #93c5fd;
            border-color: #3b82f6;
        }

        .step-pill.verified {
            background: rgba(16, 185, 129, 0.2);
            color: #34d399;
            border-color: #10b981;
        }

        .step-pill.locked {
            background: #1e293b;
            color: #64748b;
            border-color: #334155;
        }

        /* 6. EXCEL SPREADSHEET & SEO SPIDER DATA GRID */
        .spreadsheet-container {
            flex: 1;
            overflow-x: auto;
            background: #080c14;
        }

        .excel-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            color: #e2e8f0;
            background: #0b111c;
        }

        /* Excel Column Header Letters (A, B, C, D...) */
        .excel-col-letter {
            background: #1e293b;
            color: #94a3b8;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 700;
            text-align: center;
            border: 1px solid #334155;
            padding: 3px 6px;
            user-select: none;
        }

        /* Technical Column Headers */
        .excel-table th {
            background: #131d31;
            color: #cbd5e1;
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 8px 12px;
            border: 1px solid var(--border-tech);
            white-space: nowrap;
            text-align: left;
        }

        /* Excel Row Index Column (1, 2, 3...) */
        .excel-row-num {
            background: #131d31;
            color: #64748b;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 700;
            text-align: center;
            width: 36px;
            border: 1px solid var(--border-tech);
            padding: 6px;
            user-select: none;
        }

        .excel-table td {
            padding: 8px 12px;
            border: 1px solid var(--border-tech);
            vertical-align: middle;
            white-space: nowrap;
            transition: background 0.1s ease;
        }

        .excel-table tbody tr {
            cursor: pointer;
        }

        .excel-table tbody tr:hover td {
            background: #141f33 !important;
        }

        .excel-table tbody tr.row-selected td {
            background: #17243c !important;
            border-color: #3b82f6;
        }

        .excel-table tbody tr.row-selected .excel-row-num {
            background: #1e3a8a;
            color: #60a5fa;
            font-weight: 800;
        }

        /* SEO Spider Status Badges */
        .status-pill {
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 3px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .status-pill-200 {
            background: var(--spider-200-bg);
            color: #34d399;
            border: 1px solid var(--spider-200);
        }

        .status-pill-401 {
            background: var(--spider-401-bg);
            color: #fbbf24;
            border: 1px solid var(--spider-401);
        }

        /* 7. SEO SPIDER BOTTOM INSPECTION DRAWER */
        .spider-bottom-drawer {
            background: #0d1424;
            border-top: 2px solid #107c41;
            max-height: 250px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .spider-drawer-tabs {
            background: #111a2e;
            border-bottom: 1px solid var(--border-tech);
            display: flex;
            align-items: center;
            gap: 2px;
            padding: 0 12px;
            font-family: var(--font-mono);
            font-size: 11px;
        }

        .drawer-tab-btn {
            background: transparent;
            border: none;
            border-bottom: 2px solid transparent;
            color: var(--text-sub);
            padding: 8px 14px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.15s ease;
        }

        .drawer-tab-btn:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.04);
        }

        .drawer-tab-btn.active {
            color: #38bdf8;
            border-bottom-color: #38bdf8;
            background: #16223b;
        }

        .drawer-content-pane {
            padding: 12px 16px;
            font-size: 12px;
            font-family: var(--font-mono);
            color: #cbd5e1;
            line-height: 1.6;
        }

        /* 8. EXCEL WORKBOOK SHEET TABS & STATUS BAR (BOTTOM) */
        .excel-bottom-dock {
            background: #1e293b;
            border-top: 1px solid #334155;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
            font-size: 11.5px;
            font-family: var(--font-mono);
            z-index: 30;
        }

        .excel-sheet-tabs {
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .excel-sheet-tab {
            background: #0f172a;
            border: 1px solid #334155;
            border-bottom: none;
            color: #94a3b8;
            padding: 6px 14px;
            cursor: pointer;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.15s ease;
            position: relative;
            top: 1px;
            border-top-left-radius: 4px;
            border-top-right-radius: 4px;
        }

        .excel-sheet-tab:hover {
            color: #ffffff;
            background: #182234;
        }

        .excel-sheet-tab.active {
            background: #0b111c;
            color: #38bdf8;
            border-top: 2px solid #107c41;
            border-bottom: 1px solid #0b111c;
        }

        .excel-sheet-tab.is-locked {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .excel-status-bar {
            display: flex;
            align-items: center;
            gap: 16px;
            color: #94a3b8;
            padding: 5px 0;
            font-size: 11px;
        }

        /* Action Buttons */
        .btn-excel {
            background: #107c41;
            color: #ffffff;
            border: 1px solid #16a34a;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 3px;
            cursor: pointer;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-excel:hover {
            background: #0c5a2f;
            color: #ffffff;
        }

        .btn-excel-subtle {
            background: #1e293b;
            color: #cbd5e1;
            border: 1px solid #334155;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 3px;
            cursor: pointer;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-excel-subtle:hover {
            background: #334155;
            color: #ffffff;
            border-color: #475569;
        }

        /* Modal Dialog Styling (Dark Technical Excel / Spider Theme) */
        .modal-content.tech-modal {
            background: #0f172a;
            border: 1px solid #334155;
            color: #f1f5f9;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
        }

        .tech-modal .modal-header {
            background: #1e293b;
            border-bottom: 1px solid #334155;
        }

        .tech-modal .modal-footer {
            background: #131d31;
            border-top: 1px solid #334155;
        }

        .tech-form-control {
            background: #0b111c;
            border: 1px solid #334155;
            color: #f8fafc;
            font-family: var(--font-mono);
            font-size: 12px;
            border-radius: 4px;
            padding: 8px 12px;
            width: 100%;
            outline: none;
        }

        .tech-form-control:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
        }
    </style>
</head>

<body>

    <!-- Persistent Portfolio Navigation Anchors -->
    <a id="back-btn-np" href="../" title="Back to Projects"
        style="position:fixed;top:0;right:0;z-index:99999;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;background:rgba(10,10,10,0.82);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:0;border-bottom:1px solid rgba(255,255,255,0.15);border-left:1px solid rgba(255,255,255,0.15);border-radius:0 0 0 8px;color:#fff;font-family:system-ui,sans-serif;font-size:1rem;font-weight:700;text-decoration:none;box-shadow:-2px 2px 10px rgba(0,0,0,0.5);">
        &#8592;
    </a>
    <a id="case-study-btn-np" href="./case-study.html" title="Case Study" aria-label="Case Study"
        style="position:fixed;bottom:0;left:0;z-index:99999;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;background:rgba(10,10,10,0.82);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:0;border-top:1px solid rgba(255,255,255,0.15);border-right:1px solid rgba(255,255,255,0.15);border-radius:0 8px 0 0;color:#fff;font-family:system-ui,sans-serif;font-size:0.95rem;text-decoration:none;box-shadow:2px -2px 10px rgba(0,0,0,0.5);">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" style="display:block;">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
    </a>

    <!-- ═══════════════════════════════════════════════════════════════════
         1. TOP EXCEL & GOOGLE ANALYTICS TITLEBAR RIBBON
         ═══════════════════════════════════════════════════════════════════ -->
    <header class="app-top-ribbon">
        <div class="app-brand-lockup">
            <div class="excel-icon-tile">X</div>
            <div class="app-title-text">
                <span>DineDispatch</span>
                <span class="text-white opacity-40">|</span>
